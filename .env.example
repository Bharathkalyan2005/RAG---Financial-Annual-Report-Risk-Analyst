# ─── LLM (OpenRouter) ────────────────────────────────────────────────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Primary model — used for all standard requests
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Fallback model — used when primary hits rate limits (429)
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ─── Database (Neon Postgres + pgvector) ─────────────────────────────────────
# Full connection string from your Neon project dashboard
# Format: postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=

# ─── Embeddings (local, no API cost) ─────────────────────────────────────────
# Model used for chunk embeddings (1024-dim output)
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# ─── Reranker (local, no API cost) ───────────────────────────────────────────
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ─── Retrieval tuning ────────────────────────────────────────────────────────
# Number of chunks to retrieve before reranking
RETRIEVAL_TOP_K=20

# Number of chunks to keep after reranking
RERANK_TOP_N=5

# Minimum similarity score below which the system abstains
ABSTAIN_THRESHOLD=0.35
